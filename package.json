{
  "name": "frontend-react",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --watch",
    "lint": "eslint .",
    "test-headless": "jest --watchAll=false",
    "test-headless-cc": "jest --watchAll=false --coverage",
    "test:coverage": "jest --watchAll=false --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html",
    "test:coverage:ci": "jest --watchAll=false --coverage --coverageReporters=lcov --coverageReporters=json --coverageReporters=text-summary",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress run --component",
    "cypress:component:open": "cypress open --component",
    "cypress:component:coverage": "CYPRESS_COVERAGE=true cypress run --component && npx nyc report --reporter=lcov --reporter=text-summary",
    "cypress:component:coverage:open": "CYPRESS_COVERAGE=true cypress open --component",
    "cypress:e2e": "cypress run --e2e",
    "cypress:e2e:coverage": "CYPRESS_COVERAGE=true cypress run --e2e",
    "coverage:merge": "mkdir -p coverage/merged && npx lcov-result-merger 'coverage/**/lcov.info' coverage/merged/lcov.info",
    "coverage:verify": "node scripts/verify-coverage.js",
    "test:all": "pnpm test-headless && pnpm cypress:component",
    "test:all:ci": "pnpm test:coverage:ci && pnpm cypress:component",
    "coverage:report": "echo 'Coverage report generated at coverage/lcov-report/index.html'",
    "security": "./scripts/security-check.sh",
    "security:audit": "pnpm audit",
    "security:outdated": "pnpm outdated"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.6",
    "axios": "^1.18.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.12",
    "next": "^16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "sweetalert2": "^11.26.25",
    "typescript": "5.9.3",
    "yup": "^1.6.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@cypress/code-coverage": "^4.0.3",
    "@cypress/react": "^9.0.2",
    "@cypress/webpack-preprocessor": "^7.1.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@jest/globals": "30.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "30.4.1",
    "babel-plugin-istanbul": "^7.0.1",
    "css-loader": "^7.1.4",
    "cypress": "^15.19.0",
    "file-loader": "^6.2.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-sonar-reporter": "^2.0.0",
    "lcov-result-merger": "^5.0.1",
    "nyc": "^17.1.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.2",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
      "nanoid@<3.3.17": "^3.3.17",
      "handlebars": "^4.7.9",
      "systeminformation": ">=5.31.7",
      "flatted": "^3.4.2",
      "minimatch@<3.1.3": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "ajv@<6.14.0": "^6.14.0",
      "ajv@>=7.0.0 <8.18.0": "^8.18.0",
      "brace-expansion@<1.1.17": "^1.1.17",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "lodash": "^4.18.1",
      "serialize-javascript": "^7.0.5",
      "follow-redirects": ">=1.16.0",
      "fast-uri@<3.1.5": "^3.1.5",
      "uuid": ">=14.0.0",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "ws": ">=8.21.0",
      "tmp": ">=0.2.6",
      "form-data": ">=4.0.6"
    }
  }
}
